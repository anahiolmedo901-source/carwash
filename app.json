{
  "expo": {
    "name": "CarWashNow",
    "slug": "carwashnow",
    "scheme": "carwashnow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "favicon": "./assets/autolavados/centro.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CarWashNow usa tu ubicación para calcular la distancia al autolavado y confirmar tu llegada."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CarWashNow usa la cámara para escanear el código QR de tu reservación y fotografiar tu vehículo.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "CarWashNow usa los sensores de movimiento para apoyar la detección de tu llegada."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A6C90"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.carwashnow",
          "enableGooglePay": false
        }
      ]
    ],
    "android": {
      "package": "com.carwashnow.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "supportsTablet": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3f59d309-e2a0-4afa-9817-207399a17cde"
      }
    },
    "owner": "anahi_olm"
  }
}
